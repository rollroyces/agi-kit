{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title":    "fill_enclosed generator parameters",
  "type":     "object",
  "properties": {
    "n_shapes": {
      "type":        "integer",
      "minimum":     1,
      "maximum":     5,
      "description": "Number of rectangular frames to draw."
    },
    "grid_size": {
      "type":        "array",
      "minItems":    2,
      "maxItems":    2,
      "items":       { "type": "integer", "minimum": 5, "maximum": 30 },
      "description": "Fixed (rows, cols) of the output grid; if omitted, sampled per pair."
    },
    "n_train": {
      "type":        "integer",
      "minimum":     1,
      "maximum":     10,
      "default":     3,
      "description": "Number of demonstration train pairs to generate."
    }
  }
}
